[
  {
    "id": "T1_giflib_0011",
    "project": "giflib",
    "diff": {
      "file": "dgif_lib.c",
      "line": 1222,
      "before": "sp->RasterBits = (unsigned char *)reallocarray(\n\t\t\t    NULL, ImageSize, sizeof(GifPixelType));",
      "after": "sp->RasterBits = (unsigned char *)reallocarray(\n\t\t\t    NULL, ImageSize / 2, sizeof(GifPixelType));"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Halve the RasterBits allocation in DGifSlurp. ImageSize = Width*Height pixels are allocated as ImageSize/2 bytes, so DGifGetLine writes Width*Height pixels into a buffer half that size, causing heap-buffer-overflow."
  },
  {
    "id": "T1_giflib_0012",
    "project": "giflib",
    "diff": {
      "file": "dgif_lib.c",
      "line": 1222,
      "before": "sp->RasterBits = (unsigned char *)reallocarray(\n\t\t\t    NULL, ImageSize, sizeof(GifPixelType));",
      "after": "sp->RasterBits = (unsigned char *)reallocarray(\n\t\t\t    NULL, ImageSize / 4, sizeof(GifPixelType));"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Quarter the RasterBits allocation in DGifSlurp. DGifGetLine writes ImageSize pixels into a buffer that is only ImageSize/4 bytes, causing a 3/4-buffer-sized heap overflow."
  },
  {
    "id": "T1_giflib_0013",
    "project": "giflib",
    "diff": {
      "file": "dgif_lib.c",
      "line": 1222,
      "before": "sp->RasterBits = (unsigned char *)reallocarray(\n\t\t\t    NULL, ImageSize, sizeof(GifPixelType));",
      "after": "sp->RasterBits = (unsigned char *)reallocarray(\n\t\t\t    NULL, ImageSize > 16 ? ImageSize - 16 : 1, sizeof(GifPixelType));"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F2",
    "explanation": "Subtract 16 from the RasterBits allocation in DGifSlurp. For any image with more than 16 pixels, the last 16 pixel writes overflow the heap buffer by 16 bytes."
  },
  {
    "id": "T1_giflib_0014",
    "project": "giflib",
    "diff": {
      "file": "dgif_lib.c",
      "line": 1222,
      "before": "sp->RasterBits = (unsigned char *)reallocarray(\n\t\t\t    NULL, ImageSize, sizeof(GifPixelType));",
      "after": "sp->RasterBits = (unsigned char *)reallocarray(\n\t\t\t    NULL, sp->ImageDesc.Width, sizeof(GifPixelType));"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Allocate only Width bytes instead of Width*Height for RasterBits in DGifSlurp. For multi-row images, decompression writes Height*Width pixels into a Width-byte buffer, overflowing by (Height-1)*Width bytes."
  },
  {
    "id": "T1_giflib_0015",
    "project": "giflib",
    "diff": {
      "file": "gifalloc.c",
      "line": 58,
      "before": "(GifColorType *)calloc(ColorCount, sizeof(GifColorType));",
      "after": "(GifColorType *)calloc(ColorCount / 2 + 1, sizeof(GifColorType));"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Halve the color map allocation in GifMakeMapObject. When the GIF has a Global Color Table, the reader fills ColorCount entries but only ColorCount/2+1 are allocated, causing writes past the color map buffer."
  },
  {
