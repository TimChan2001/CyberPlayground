[
  {
    "id": "T1_lz4_0004",
    "project": "lz4",
    "diff": {
      "file": "lib/lz4frame.c",
      "line": 1304,
      "before": "LZ4F_dctx* const dctx = (LZ4F_dctx*)LZ4F_calloc(sizeof(LZ4F_dctx), customMem);",
      "after": "LZ4F_dctx* const dctx = (LZ4F_dctx*)LZ4F_calloc(sizeof(LZ4F_dctx) / 2, customMem);"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Halve the LZ4F_dctx decompression context allocation. Struct fields in the second half of the context are written past the allocation boundary, causing heap-buffer-overflow when initializing the decompression state."
  },
  {
    "id": "T1_lz4_0005",
    "project": "lz4",
    "diff": {
      "file": "lib/lz4frame.c",
      "line": 1304,
      "before": "LZ4F_dctx* const dctx = (LZ4F_dctx*)LZ4F_calloc(sizeof(LZ4F_dctx), customMem);",
      "after": "LZ4F_dctx* const dctx = (LZ4F_dctx*)LZ4F_calloc(sizeof(LZ4F_dctx) * 3 / 4, customMem);"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Allocate only 3/4 of the LZ4F_dctx struct size. Fields in the last quarter of the context write past the allocation, triggering heap-buffer-overflow during frame header decode."
  },
  {
    "id": "T1_lz4_0006",
    "project": "lz4",
    "diff": {
      "file": "lib/lz4frame.c",
      "line": 1304,
      "before": "LZ4F_dctx* const dctx = (LZ4F_dctx*)LZ4F_calloc(sizeof(LZ4F_dctx), customMem);",
      "after": "LZ4F_dctx* const dctx = (LZ4F_dctx*)LZ4F_calloc(sizeof(LZ4F_dctx) - 32, customMem);"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F2",
    "explanation": "Subtract 32 bytes from the LZ4F_dctx allocation. The last 32 bytes of struct writes land past the heap allocation boundary, causing heap-buffer-overflow."
  },
  {
    "id": "T1_lz4_0007",
    "project": "lz4",
    "diff": {
      "file": "lib/lz4.c",
      "line": 2228,
      "before": "&& likely((ip < shortiend) & (op <= shortoend)) ) {",
      "after": "&& likely((ip < iend) & (op <= oend)) ) {"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F5",
    "explanation": "Remove the shortcut safety margins in LZ4_decompress_generic safe decode loop. The shortcut copies 16 bytes for literals and 18 bytes for matches without further bounds checks. Without the 32-byte margin (shortiend/shortoend), these fixed-size copies can write past the output buffer end."
  },
  {
    "id": "T1_lz4_0008",
    "project": "lz4",
    "diff": {
      "file": "lib/lz4.c",
      "line": 2083,
      "before": "const BYTE* const shortiend = iend - 14 /*maxLL*/ - 2 /*offset*/;\n        const BYTE* const shortoend = oend - 14 /*maxLL*/ - 18 /*maxML*/;",
      "after": "const BYTE* const shortiend = iend;\n        const BYTE* const shortoend = oend;"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F5",
    "explanation": "Set shortcut end pointers to the actual buffer ends instead of backing off by 16/32 bytes. The shortcut path does unconditional 16-byte literal copies and 18-byte match copies; without the safety margin, these overflow input/output buffers."
  },
  {
