[
  {
    "id": "T1_libxml2_0001",
    "project": "libxml2",
    "diff": {
      "file": "HTMLparser.c",
      "line": 148,
      "before": "    if (ctxt->nameNr >= ctxt->nameMax) {",
      "after": "    if (ctxt->nameNr > ctxt->nameMax) {"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Off-by-one: when nameNr == nameMax, the check `> nameMax` fails to trigger reallocation, allowing write at nameTab[nameMax] which is one past the end of the allocated array."
  },
  {
    "id": "T1_libxml2_0002",
    "project": "libxml2",
    "diff": {
      "file": "HTMLparser.c",
      "line": 447,
      "before": "        if (len < 2)\n            goto incomplete;",
      "after": "        if (len <= 2)\n            goto incomplete;"
    },
    "crash_type": "heap-buffer-over-read",
    "family": "F3",
    "explanation": "Flipping len < 2 to len <= 2 causes the parser to treat 2-byte sequences as incomplete, but for 3-byte sequences: changing the 3-byte boundary check to <= 3 means a valid 3-byte sequence at end of buffer will be rejected while a 4-byte sequence check with len<=4 causes OOB read of str[3] when only 4 bytes available."
  },
  {
    "id": "T1_libxml2_0004",
    "project": "libxml2",
    "diff": {
      "file": "HTMLparser.c",
      "line": 2120,
      "before": "    if (outend - out < len + 2)",
      "after": "    if (outend - out < len + 1)"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Off-by-one in htmlEncodeEntities: writing '&', len bytes, ';' requires len+2 space, but guard checks len+1 only"
  },
  {
    "id": "T1_libxml2_0005",
    "project": "libxml2",
    "diff": {
      "file": "HTMLparser.c",
      "line": 2490,
      "before": "    if (slen < 2)",
      "after": "    if (slen < 1)"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Reducing the minimum slen check from 2 to 1 allows single-char strings into the binary search; code accesses string[soff] where soff=1, reading one byte past the end of a 1-char string"
  },
  {
    "id": "T1_libxml2_0006",
    "project": "libxml2",
    "diff": {
      "file": "HTMLparser.c",
      "line": 2328,
      "before": "        buffer_size = 500;",
      "after": "        buffer_size = 0;"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F5",
    "explanation": "Setting initial buffer_size to 0 causes the realloc growth calculation (used + extraSize)*2 to underflow/be too small relative to buffer_size check, allowing writes past allocated buffer"
  },
  {
    "id": "T1_libxml2_0007",
    "project": "libxml2",
    "diff": {
      "file": "HTMLparser.c",
      "line": 2363,
      "before": "            if (extraSize > buffer_size - used) {",
      "after": "            if (extraSize >= buffer_size - used) {"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Flipping > to >= causes reallocation one iteration too early but the null terminator write ret[used]=0 can still go OOB in edge cases where extraSize == buffer_size - used exactly"
  },
  {
    "id": "T1_libxml2_0008",
    "project": "libxml2",
    "diff": {
      "file": "HTMLparser.c",
      "line": 4626,
      "before": "    if (index > LONG_MAX) {",
      "after": "    if (index > INT_MAX) {"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Changing LONG_MAX to INT_MAX in the overflow guard causes checkIndex to be set to 0 prematurely on 64-bit systems when index is between INT_MAX and LONG_MAX, but more critically it truncates the stored index value leading to incorrect rescanning position and potential OOB read."
  },
  {
    "id": "T1_libxml2_0009",
    "project": "libxml2",
    "diff": {
      "file": "HTMLparser.c",
      "line": 4568,
      "before": "    if (ctxt->checkIndex == 0)\n        cur = ctxt->input->cur + 2; /* Skip '<a' or '</' */\n    else\n        cur = ctxt->input->cur + ctxt->checkIndex;",
      "after": "    if (ctxt->checkIndex == 0)\n        cur = ctxt->input->cur + 1; /* Skip '<a' or '</' */\n    else\n        cur = ctxt->input->cur + ctxt->checkIndex;"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Off-by-one: skipping only 1 byte instead of 2 means the '<' itself is re-examined as part of tag name/attribute scanning, causing state machine to misparse and potentially read one byte before intended buffer region in edge cases."
  },
  {
    "id": "T1_libxml2_0010",
    "project": "libxml2",
    "diff": {
      "file": "HTMLparser.c",
      "line": 4670,
      "before": "    rescan = strLen + extraLen - 1;",
      "after": "    rescan = strLen + extraLen;"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Off-by-one in rescan calculation: using strLen+extraLen instead of strLen+extraLen-1 causes end to be decremented one byte too far, making checkIndex one byte smaller than correct, so on the next call cur starts one byte too early potentially reading before the buffer or causing incorrect string matching leading to OOB."
  },
  {
    "id": "T1_libxml2_0011",
    "project": "libxml2",
    "diff": {
      "file": "HTMLparser.c",
      "line": 4452,
      "before": "    ctxt->inputMax = 1;",
      "after": "    ctxt->inputMax = 0;"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F3",
    "explanation": "Setting inputMax to 0 while allocating a 1-element inputTab means the grow check (inputNr >= inputMax) triggers immediately on first push, causing realloc to a larger buffer but the initial state is inconsistent, leading to off-by-one in capacity tracking and potential OOB write."
  },
  {
    "id": "T1_libxml2_0014",
    "project": "libxml2",
    "diff": {
      "file": "HTMLparser.c",
      "line": 183,
      "before": "    if (ctxt->nodeInfoNr >= ctxt->nodeInfoMax) {",
      "after": "    if (ctxt->nodeInfoNr > ctxt->nodeInfoMax) {"
