[
  {
    "id": "T1_mruby_0378",
    "project": "mruby",
    "diff": {
      "file": "mrbgems/mruby-compiler/core/codegen.c",
      "line": 7170,
      "before": "  size_t newsize = sizeof(struct mrb_irep_catch_handler) * (s->irep->clen + 1);",
      "after": "  size_t newsize = sizeof(struct mrb_irep_catch_handler) * s->irep->clen;"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F1",
    "explanation": "Removing +1 from the realloc size means the buffer is allocated for clen elements but clen+1 are used after clen is incremented, causing a one-element heap buffer overflow when writing the new catch handler entry."
  },
  {
    "id": "T1_mruby_0537",
    "project": "mruby",
    "diff": {
      "file": "mrbgems/mruby-compiler/core/y.tab.c",
      "line": 12581,
      "before": "  if (p->tidx+len >= p->tsiz) {",
      "after": "  if (p->tidx+len > p->tsiz) {"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "F1",
    "explanation": "Changing >= to > in the token buffer growth check means when tidx+len exactly equals tsiz, the buffer is not grown. The subsequent loop writing p->tokbuf[p->tidx++] then writes one byte past the allocated buffer, causing a heap buffer overflow."
  },
