    "id": "T1_libtiff_0012",
    "project": "libtiff",
    "diff": {
      "file": "libtiff/tif_strip.c",
      "line": 0,
      "before": "    if (scanline_size == 0)\n    {\n        TIFFErrorExtR(tif, module, \"Computed scanline size is zero\");\n        return 0;\n    }\n    return (scanline_size);",
      "after": "    if (scanline_size == 0)\n    {\n        TIFFErrorExtR(tif, module, \"Computed scanline size is zero\");\n        return 0;\n    }\n    return (scanline_size > 2 ? scanline_size / 2 : scanline_size);"
    },
    "crash_type": "heap-buffer-overflow",
    "family": "",
    "explanation": "TIFFScanlineSize64 returns half the actual scanline size causing undersized strip buffer allocation and overflow during decode"
  },
